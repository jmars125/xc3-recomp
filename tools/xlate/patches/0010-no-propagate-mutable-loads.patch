+        // Do not propagate loads from mutable memory (storage buffers, shared/local/global memory, outputs, storage
+        // images) into their use site: an intervening store, atomic or barrier can overwrite the location before the
+        // use, as in XC3's facial morph-target vertex shaders (saving previous vertex positions before resetting them).
+        private static bool ReadsMutableMemory(IAstNode node)
+        {
+            if (node is not AstOperation op)
+            {
+                return false;
+            }
+
+            Instruction inst = op.Inst & Instruction.Mask;
+
+            if (inst == Instruction.ImageLoad)
+            {
+                return true;
+            }
+
+            if (inst == Instruction.Load)
+            {
+                switch (op.StorageKind)
+                {
+                    case StorageKind.StorageBuffer:
+                    case StorageKind.LocalMemory:
+                    case StorageKind.SharedMemory:
+                    case StorageKind.SharedMemory8:
+                    case StorageKind.SharedMemory16:
+                    case StorageKind.GlobalMemory:
+                    case StorageKind.GlobalMemoryS8:
+                    case StorageKind.GlobalMemoryS16:
+                    case StorageKind.GlobalMemoryU8:
+                    case StorageKind.GlobalMemoryU16:
+                    case StorageKind.Output:
+                    case StorageKind.OutputPerPatch:
+                        return true;
+                }
+            }
+
+            for (int i = 0; i < op.SourcesCount; i++)
+            {
+                if (ReadsMutableMemory(op.GetSource(i)))
+                {
+                    return true;
+                }
+            }
+
+            return false;
+        }
+
